{
 "version": 1,
 "phases": [
  {
   "id": "plan",
   "title": "Plan",
   "summary": "Turn an idea into a scoped, designed, estimated piece of work"
  },
  {
   "id": "build",
   "title": "Build",
   "summary": "Write the change with design rules applied at write-time"
  },
  {
   "id": "verify",
   "title": "Verify",
   "summary": "Prove the change is correct, safe, and tested before merge"
  },
  {
   "id": "ship",
   "title": "Ship",
   "summary": "Package, describe, gate, and deploy the change"
  },
  {
   "id": "operate",
   "title": "Operate",
   "summary": "Run it in production — signals, SLOs, response"
  },
  {
   "id": "learn",
   "title": "Learn",
   "summary": "Turn bugs, slowness, and incidents into fixes and lessons"
  },
  {
   "id": "maintain",
   "title": "Maintain",
   "summary": "Keep the codebase healthy between features"
  },
  {
   "id": "team",
   "title": "Team",
   "summary": "People work outside the change lifecycle"
  }
 ],
 "artifacts": {
  "prd": {
   "file": "prd.md",
   "desc": "Problem, users, scope, success metrics"
  },
  "estimate": {
   "file": "estimate.md",
   "desc": "Task breakdown with sizes and risk"
  },
  "design": {
   "file": "design.md",
   "desc": "Technical design doc"
  },
  "threat-model": {
   "file": "threat-model.md",
   "desc": "STRIDE table, mitigations, residual risk"
  },
  "adr": {
   "file": "adr.md",
   "desc": "Architecture decision record"
  },
  "api-contract": {
   "file": "api-contract.yaml",
   "desc": "OpenAPI / protobuf / AsyncAPI contract"
  },
  "diff": {
   "file": "diff.patch",
   "desc": "The change under work"
  },
  "complexity-note": {
   "file": "complexity.md",
   "desc": "Per-change Big O notes"
  },
  "findings": {
   "file": "findings.json",
   "desc": "Severity-tagged findings (schema: lifecycle/schemas/findings.schema.json)"
  },
  "tests": {
   "file": "tests.md",
   "desc": "Tests written / gaps found, with pass/fail"
  },
  "repro": {
   "file": "repro.md",
   "desc": "Minimal reproduction + failing test path"
  },
  "commit": {
   "file": "commit.txt",
   "desc": "Commit message"
  },
  "pr": {
   "file": "pr.md",
   "desc": "PR description"
  },
  "release-notes": {
   "file": "release-notes.md",
   "desc": "User-facing changelog"
  },
  "deploy-plan": {
   "file": "deploy-plan.md",
   "desc": "Ordered deploy steps, verification, rollback"
  },
  "readiness": {
   "file": "readiness.md",
   "desc": "Go/no-go scorecard"
  },
  "slo": {
   "file": "slo.md",
   "desc": "SLIs, SLOs, burn-rate alerts"
  },
  "dashboards": {
   "file": "dashboards/",
   "desc": "Dashboards and alert rules"
  },
  "runbook": {
   "file": "runbook.md",
   "desc": "Symptom → mitigation runbook"
  },
  "triage": {
   "file": "triage.md",
   "desc": "Severity, first actions, escalation"
  },
  "timeline": {
   "file": "timeline.md",
   "desc": "UTC incident timeline from logs"
  },
  "rca": {
   "file": "rca.md",
   "desc": "Root cause, contributing factors, action items"
  },
  "action-items": {
   "file": "action-items.md",
   "desc": "Owned, dated follow-ups"
  },
  "debt-register": {
   "file": "debt-register.md",
   "desc": "Ranked tech-debt items"
  },
  "docs": {
   "file": "docs/",
   "desc": "Generated documentation"
  }
 },
 "agents": {
  "plan": {
   "entry": "prd-writer",
   "owns": [
    "prd-writer",
    "tech-design",
    "threat-model",
    "estimation",
    "adr"
   ],
   "loop": "design"
  },
  "build": {
   "entry": "complexity-aware-coding",
   "owns": [
    "api-contract",
    "api-design-go-gin",
    "api-design-node-express",
    "api-design-python-fastapi",
    "api-design-python-django",
    "frontend-react-nextjs",
    "frontend-vue-nuxt",
    "complexity-aware-coding",
    "money-handling",
    "db-migration",
    "refactor",
    "feature-flag-rollout",
    "reconciliation-design"
   ],
   "loop": "build"
  },
  "verify": {
   "entry": "code-review",
   "owns": [
    "test-gap",
    "test-generation",
    "e2e-testing",
    "contract-testing",
    "load-testing",
    "a11y-review",
    "security-review",
    "compliance-review",
    "idempotency-review",
    "webhook-hardening",
    "iac-review",
    "code-review"
   ],
   "loop": "review"
  },
  "ship": {
   "entry": "commit-message",
   "owns": [
    "commit-message",
    "pr-description",
    "release-notes",
    "production-readiness",
    "deploy-plan"
   ],
   "loop": "rollout"
  },
  "operate": {
   "entry": "oncall-triage",
   "owns": [
    "slo-definition",
    "observability",
    "runbook",
    "oncall-triage",
    "incident-comms",
    "log-analysis",
    "cost-review"
   ],
   "loop": "incident"
  },
  "learn": {
   "entry": "debug",
   "owns": [
    "bug-repro",
    "debug",
    "perf-analysis",
    "rca",
    "retro"
   ],
   "loop": "debug"
  },
  "maintain": {
   "entry": "tech-debt-scan",
   "owns": [
    "tech-debt-scan",
    "dependency-upgrade",
    "deprecation",
    "capability-extraction",
    "db-scoping",
    "docs-writer",
    "onboarding"
   ],
   "loop": null
  },
  "team": {
   "entry": "interview-kit",
   "owns": [
    "interview-kit"
   ],
   "loop": null
  }
 },
 "loops": {
  "design": {
   "body": [
    "tech-design",
    "threat-model",
    "adr"
   ],
   "exit": "Every open question in design.md has an answer or an owner; every HIGH threat has a mitigation",
   "metric": "open_questions",
   "max_iterations": 3,
   "no_progress": 2,
   "checkpoint": "each_iteration"
  },
  "build": {
   "body": [
    "complexity-aware-coding",
    "test-generation"
   ],
   "exit": "Tests pass and every changed function has a complexity note",
   "metric": "failing_tests",
   "max_iterations": 4,
   "no_progress": 2,
   "checkpoint": "on_exit"
  },
  "review": {
   "body": [
    "code-review",
    "security-review",
    "test-gap"
   ],
   "exit": "No CRITICAL or HIGH findings open (wontfix requires a human)",
   "metric": "open_high_findings",
   "max_iterations": 3,
   "no_progress": 2,
   "checkpoint": "each_iteration"
  },
  "debug": {
   "body": [
    "debug"
   ],
   "exit": "A regression test fails before the fix and passes after",
   "metric": "repro_failures",
   "max_iterations": 6,
   "no_progress": 3,
   "checkpoint": "on_exit"
  },
  "perf": {
   "body": [
    "perf-analysis"
   ],
   "exit": "Target latency/throughput met, measured, not estimated",
   "metric": "ms_over_target",
   "max_iterations": 4,
   "no_progress": 2,
   "checkpoint": "each_iteration"
  },
  "incident": {
   "body": [
    "oncall-triage",
    "log-analysis",
    "incident-comms"
   ],
   "exit": "Impact mitigated and confirmed by the SLI recovering",
   "metric": "errors_over_slo",
   "max_iterations": 8,
   "no_progress": 3,
   "checkpoint": "each_iteration"
  },
  "rollout": {
   "body": [
    "deploy-plan"
   ],
   "exit": "Flag / canary at 100% with gate metrics green, or rolled back",
   "metric": "ramp_percent_remaining",
   "max_iterations": 6,
   "no_progress": 2,
   "checkpoint": "each_iteration"
  }
 },
 "edges": [
  {
   "from": "prd-writer",
   "to": "tech-design",
   "when": "always"
  },
  {
   "from": "prd-writer",
   "to": "slo-definition",
   "when": {
    "ask": "Is this a new service or a new user-facing journey?"
   }
  },
  {
   "from": "tech-design",
   "to": "threat-model",
   "when": {
    "ask": "Does the design add a trust boundary, auth path, or new external input?"
   }
  },
  {
   "from": "tech-design",
   "to": "adr",
   "when": {
    "ask": "Did the design make a hard-to-reverse choice between real alternatives?"
   }
  },
  {
   "from": "tech-design",
   "to": "api-contract",
   "when": {
    "ask": "Does the design add or change an API?"
   }
  },
  {
   "from": "tech-design",
   "to": "feature-flag-rollout",
   "when": {
    "ask": "Is the change risky enough to ship dark behind a flag?"
   }
  },
  {
   "from": "tech-design",
   "to": "estimation",
   "when": "always"
  },
  {
   "from": "threat-model",
   "to": "estimation",
   "when": "always"
  },
  {
   "from": "api-contract",
   "to": "api-design-go-gin",
   "when": {
    "content": [
     "github.com/gin-gonic/gin"
    ]
   }
  },
  {
   "from": "api-contract",
   "to": "api-design-node-express",
   "when": {
    "content": [
     "express"
    ]
   }
  },
  {
   "from": "api-contract",
   "to": "api-design-python-fastapi",
   "when": {
    "content": [
     "fastapi"
    ]
   }
  },
  {
   "from": "api-contract",
   "to": "api-design-python-django",
   "when": {
    "content": [
     "rest_framework"
    ]
   }
  },
  {
   "from": "api-contract",
   "to": "contract-testing",
   "when": {
    "ask": "Does another service consume this API?"
   }
  },
  {
   "from": "estimation",
   "to": "complexity-aware-coding",
   "when": "always"
  },
  {
   "from": "estimation",
   "to": "frontend-react-nextjs",
   "when": {
    "paths": [
     "**/next.config.*",
     "**/app/**/page.tsx",
     "**/app/**/layout.tsx"
    ]
   }
  },
  {
   "from": "estimation",
   "to": "frontend-vue-nuxt",
   "when": {
    "paths": [
     "**/*.vue",
     "**/nuxt.config.*"
    ]
   }
  },
  {
   "from": "frontend-react-nextjs",
   "to": "a11y-review",
   "when": "always"
  },
  {
   "from": "frontend-react-nextjs",
   "to": "e2e-testing",
   "when": "always"
  },
  {
   "from": "frontend-vue-nuxt",
   "to": "a11y-review",
   "when": "always"
  },
  {
   "from": "frontend-vue-nuxt",
   "to": "e2e-testing",
   "when": "always"
  },
  {
   "from": "tech-design",
   "to": "reconciliation-design",
   "when": {
    "ask": "Does the design move money between systems whose records must agree?"
   }
  },
  {
   "from": "reconciliation-design",
   "to": "money-handling",
   "when": "always"
  },
  {
   "from": "reconciliation-design",
   "to": "idempotency-review",
   "when": "always"
  },
  {
   "from": "e2e-testing",
   "to": "code-review",
   "when": "always"
  },
  {
   "from": "complexity-aware-coding",
   "to": "@verify",
   "when": "always"
  },
  {
   "from": "db-migration",
   "to": "deploy-plan",
   "when": "always"
  },
  {
   "from": "refactor",
   "to": "test-generation",
   "when": "always"
  },
  {
   "from": "test-gap",
   "to": "test-generation",
   "when": {
    "artifact": "tests"
   }
  },
  {
   "from": "code-review",
   "to": "commit-message",
   "when": "always"
  },
  {
   "from": "commit-message",
   "to": "pr-description",
   "when": "always"
  },
  {
   "from": "pr-description",
   "to": "@verify",
   "when": "always"
  },
  {
   "from": "code-review",
   "to": "deploy-plan",
   "when": {
    "paths": [
     "**/migrations/**",
     "**/*.tf",
     "**/helm/**",
     "**/k8s/**"
    ]
   }
  },
  {
   "from": "code-review",
   "to": "release-notes",
   "when": {
    "ask": "Is this merge part of a release?"
   }
  },
  {
   "from": "release-notes",
   "to": "production-readiness",
   "when": {
    "ask": "Is this a first launch or a major change?"
   }
  },
  {
   "from": "production-readiness",
   "to": "deploy-plan",
   "when": "always"
  },
  {
   "from": "load-testing",
   "to": "production-readiness",
   "when": "always"
  },
  {
   "from": "deploy-plan",
   "to": "observability",
   "when": "always"
  },
  {
   "from": "slo-definition",
   "to": "observability",
   "when": "always"
  },
  {
   "from": "observability",
   "to": "runbook",
   "when": "always"
  },
  {
   "from": "oncall-triage",
   "to": "log-analysis",
   "when": "always"
  },
  {
   "from": "oncall-triage",
   "to": "incident-comms",
   "when": {
    "ask": "Is the incident customer-visible?"
   }
  },
  {
   "from": "log-analysis",
   "to": "rca",
   "when": "always"
  },
  {
   "from": "incident-comms",
   "to": "rca",
   "when": "always"
  },
  {
   "from": "rca",
   "to": "retro",
   "when": "always"
  },
  {
   "from": "rca",
   "to": "runbook",
   "when": "always"
  },
  {
   "from": "retro",
   "to": "prd-writer",
   "when": {
    "ask": "Does an action item need product work?"
   }
  },
  {
   "from": "cost-review",
   "to": "iac-review",
   "when": {
    "paths": [
     "**/*.tf",
     "**/helm/**",
     "**/k8s/**"
    ]
   }
  },
  {
   "from": "bug-repro",
   "to": "debug",
   "when": "always"
  },
  {
   "from": "debug",
   "to": "test-generation",
   "when": "always"
  },
  {
   "from": "debug",
   "to": "rca",
   "when": {
    "ask": "Did the bug reach production users?"
   }
  },
  {
   "from": "perf-analysis",
   "to": "complexity-aware-coding",
   "when": "always"
  },
  {
   "from": "perf-analysis",
   "to": "load-testing",
   "when": "always"
  },
  {
   "from": "tech-debt-scan",
   "to": "refactor",
   "when": "always"
  },
  {
   "from": "tech-debt-scan",
   "to": "dependency-upgrade",
   "when": "always"
  },
  {
   "from": "tech-debt-scan",
   "to": "deprecation",
   "when": {
    "ask": "Is any debt item dead code or an unused API?"
   }
  },
  {
   "from": "tech-debt-scan",
   "to": "test-generation",
   "when": "always"
  },
  {
   "from": "dependency-upgrade",
   "to": "test-gap",
   "when": "always"
  },
  {
   "from": "deprecation",
   "to": "deploy-plan",
   "when": "always"
  },
  {
   "from": "deprecation",
   "to": "release-notes",
   "when": "always"
  },
  {
   "from": "capability-extraction",
   "to": "tech-design",
   "when": "always"
  },
  {
   "from": "db-scoping",
   "to": "tech-design",
   "when": "always"
  },
  {
   "from": "onboarding",
   "to": "docs-writer",
   "when": {
    "ask": "Were doc gaps found during onboarding?"
   }
  }
 ],
 "conflicts": {
  "review_order": [
   "compliance-review",
   "security-review",
   "idempotency-review",
   "webhook-hardening",
   "money-handling",
   "db-migration",
   "iac-review",
   "a11y-review",
   "contract-testing",
   "test-gap",
   "code-review"
  ],
  "dedupe": {
   "key": [
    "file",
    "line",
    "category"
   ],
   "keep": "highest_severity",
   "merge": "credit_all_sources"
  },
  "disambiguate": [
   {
    "pair": [
     "capability-extraction",
     "db-scoping"
    ],
    "rule": "behaviours/services → capability-extraction; tables/data → db-scoping"
   },
   {
    "pair": [
     "perf-analysis",
     "load-testing"
    ],
    "rule": "something is slow now → perf-analysis; will it hold under load → load-testing"
   },
   {
    "pair": [
     "security-review",
     "threat-model"
    ],
    "rule": "a diff exists → security-review; only a design exists → threat-model"
   },
   {
    "pair": [
     "test-gap",
     "test-generation"
    ],
    "rule": "which tests are missing → test-gap; write them → test-generation"
   },
   {
    "pair": [
     "release-notes",
     "deploy-plan"
    ],
    "rule": "for users → release-notes; for whoever deploys → deploy-plan"
   },
   {
    "pair": [
     "debug",
     "rca"
    ],
    "rule": "make it work → debug; why did it happen and how do we stop it → rca"
   },
   {
    "pair": [
     "log-analysis",
     "rca"
    ],
    "rule": "build the timeline → log-analysis; explain it → rca"
   }
  ],
  "max_parallel": 4
 },
 "nodes": {
  "prd-writer": {
   "phase": "plan",
   "triggers": {
    "intents": [
     "\\bprd\\b",
     "product (spec|brief|requirements)",
     "feature idea",
     "write (a )?spec"
    ],
    "events": [
     "idea"
    ]
   },
   "inputs": [],
   "outputs": [
    "prd"
   ],
   "summary": "Turn a rough product ask into a structured Product Requirements Document."
  },
  "estimation": {
   "phase": "plan",
   "triggers": {
    "intents": [
     "\\bestimat",
     "how long (will|would)",
     "t-?shirt",
     "size (these|this|the) task",
     "story points"
    ],
    "events": [
     "spec-ready"
    ]
   },
   "inputs": [
    "prd",
    "design"
   ],
   "outputs": [
    "estimate"
   ],
   "summary": "Break a spec / PRD / feature into tasks with T-shirt sizes (XS / S / M / L / XL), risk flags, dependencies, and an honest range (best / likely / worst)."
  },
  "tech-design": {
   "phase": "plan",
   "triggers": {
    "intents": [
     "(tech(nical)?|system) design",
     "design doc",
     "\\brfc\\b",
     "how should we (build|architect)",
     "architecture for"
    ],
    "events": [
     "spec-ready"
    ]
   },
   "inputs": [
    "prd"
   ],
   "outputs": [
    "design"
   ],
   "summary": "Write a technical design doc (TDD / design doc / RFC) that sits between the PRD and the ADRs — goals and non-goals, current state, proposed design (components …"
  },
  "threat-model": {
   "phase": "plan",
   "triggers": {
    "intents": [
     "threat model",
     "\\bstride\\b",
     "attack surface",
     "abuse case",
     "trust boundar"
    ],
    "events": [
     "design-ready"
    ]
   },
   "inputs": [
    "design"
   ],
   "outputs": [
    "threat-model"
   ],
   "summary": "Design-time threat model for a feature, service, or architecture — inventories assets, entry points, and trust boundaries, draws the data-flow diagram, runs …"
  },
  "adr": {
   "phase": "plan",
   "triggers": {
    "intents": [
     "\\badr\\b",
     "decision record",
     "document (this|the|our) decision",
     "why did we (choose|pick)"
    ]
   },
   "inputs": [
    "design"
   ],
   "outputs": [
    "adr"
   ],
   "summary": "Write an Architecture Decision Record (ADR / MADR format) capturing a technical decision — context, options considered, decision, consequences, and status."
  },
  "api-contract": {
   "phase": "build",
   "triggers": {
    "intents": [
     "api contract",
     "openapi",
     "swagger",
     "\\bproto(buf)?\\b",
     "asyncapi",
     "breaking (api )?change",
     "version(ing)? (the|this|our) api"
    ],
    "paths": [
     "**/openapi*.y*ml",
     "**/openapi*.json",
     "**/swagger*.y*ml",
     "**/*.proto",
     "**/asyncapi*.y*ml"
    ],
    "events": [
     "design-ready"
    ]
   },
   "inputs": [
    "design"
   ],
   "outputs": [
    "api-contract"
   ],
   "summary": "Contract-first API design, framework-agnostic — writes or reviews the spec before the code (OpenAPI 3.1 for HTTP, protobuf for gRPC, AsyncAPI for events)."
  },
  "api-design-go-gin": {
   "phase": "build",
   "triggers": {
    "intents": [
     "\\bgin\\b.*(endpoint|handler|route|api)",
     "(endpoint|handler|route|api).*\\bgin\\b"
    ],
    "content": [
     "gin\\.(Context|Engine|Default|New)\\b",
     "\"github.com/gin-gonic/gin\""
    ]
   },
   "inputs": [
    "api-contract"
   ],
   "outputs": [
    "findings"
   ],
   "summary": "Design or review a REST API written in Go with the Gin framework."
  },
  "api-design-node-express": {
   "phase": "build",
   "triggers": {
    "intents": [
     "\\bexpress\\b.*(endpoint|handler|route|router|api)",
     "(endpoint|route|router|api).*\\bexpress\\b"
    ],
    "content": [
     "express\\.Router\\(",
     "require\\(.express.\\)",
     "from .express."
    ]
   },
   "inputs": [
    "api-contract"
   ],
   "outputs": [
