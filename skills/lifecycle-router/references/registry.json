    ]
   },
   "inputs": [],
   "outputs": [
    "findings"
   ],
   "summary": "Audit a single service for cross-cutting BEHAVIORS it implements locally that don't belong to its domain — notifications, PDF generation, file upload, audit …"
  },
  "db-scoping": {
   "phase": "maintain",
   "triggers": {
    "intents": [
     "tables? should (this|the|x) (service )?not touch",
