     "**/package-lock.json",
     "**/pnpm-lock.yaml",
     "**/yarn.lock",
     "**/requirements*.txt",
     "**/pyproject.toml",
     "**/poetry.lock",
     "**/uv.lock",
     "**/go.mod",
     "**/go.sum",
     "**/Gemfile*",
     "**/pom.xml",
     "**/build.gradle*",
     "**/Cargo.toml"
    ],
    "always_on": [
     "dependency-alert"
    ]
   },
   "inputs": [
    "debt-register"
   ],
   "outputs": [
    "diff"
   ],
   "summary": "Plan and execute a dependency version upgrade — Python 3.x, Node LTS, Go, framework major versions, or transitive dep bumps for CVEs."
  },
  "tech-debt-scan": {
