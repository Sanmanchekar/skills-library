    "events": [
     "schedule"
    ]
   },
   "inputs": [],
   "outputs": [
    "debt-register"
   ],
   "summary": "Scan a repository for technical debt and produce a ranked debt register."
  },
  "deprecation": {
   "phase": "maintain",
   "triggers": {
    "intents": [
     "deprecat",
     "sunset",
     "remove (this|the|an?) (api|endpoint|feature|flag)",
